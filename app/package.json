{
  "name": "homebar-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "홈바 종합 주류 플랫폼 - 기존 홈바 레지스트리 DB 기반 웹앱",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:demo": "vite build --config vite.config.demo.ts",
    "build:public": "tsc --noEmit -p tsconfig.json && vite build --mode public",
    "seed:public": "node scripts/makePublicSeed.mjs",
    "build:demo:public": "vite build --config vite.config.demo.ts --mode public"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  }
}
